<script>
// Accordions
document.querySelectorAll('.acc>button').forEach(function(b){
  b.addEventListener('click',function(){
    var a=b.parentElement,o=a.classList.toggle('open');
    b.setAttribute('aria-expanded',o);
  });
});
// Menu and theme
var nav=document.getElementById('nav'),mb=document.getElementById('menu');
mb.addEventListener('click',function(){var o=nav.classList.toggle('open');mb.setAttribute('aria-expanded',o)});
nav.addEventListener('click',function(e){if(e.target.tagName==='A'){nav.classList.remove('open');mb.setAttribute('aria-expanded','false')}});
document.getElementById('theme').addEventListener('click',function(){
  var r=document.documentElement,d=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
  r.dataset.theme=d?'light':'dark';
});
// Copy email
document.getElementById('copy').addEventListener('click',function(){
  var m=document.getElementById('msg'),e='jimenea.ricky.socmed@gmail.com';
  try{navigator.clipboard.writeText(e).then(function(){m.textContent='Copied.'},function(){m.textContent=e})}catch(x){m.textContent=e}
  setTimeout(function(){m.textContent=''},3000);
});
// Pipeline board: one deal moves per tick, closes, then resets
(function(){
  var deals=[].slice.call(document.querySelectorAll('.deal')),st=[0,0,0],turn=0,still=matchMedia('(prefers-reduced-motion: reduce)').matches;
  function draw(i){deals[i].style.left='calc('+st[i]*25+'% + 4px)';deals[i].classList.toggle('won',st[i]===3);deals[i].textContent=st[i]===3?(i===2?'Retained':'Closed won'):deals[i].dataset.name}
  if(still){st=[3,3,3];deals.forEach(function(d,i){draw(i)});return}
  deals.forEach(function(d,i){draw(i)});
  setInterval(function(){
    var i=turn%3;
    if(st[i]<3){st[i]++;draw(i)}else{st[i]=0;draw(i)}
    turn++;
  },1100);
})();
</script>
