<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ricky Jimenea – Sales & Client Success</title>
<meta name="description" content="Sales and client success professional: outbound sales, retention, escalations and Salesforce pipelines.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F5F7FA;--surface:#fff;--ink:#0F1B33;--muted:#55627A;--line:#DCE2EC;--accent:#0B7A75;--accent-ink:#fff;--warn:#C7821C;--hbg:rgba(245,247,250,.92);
--disp:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;--body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0C1424;--surface:#131D33;--ink:#EAF0FA;--muted:#9AA8C2;--line:#25324D;--accent:#3FD0B5;--accent-ink:#06231E;--warn:#F0B35A;--hbg:rgba(12,20,36,.92);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0C1424;--surface:#131D33;--ink:#EAF0FA;--muted:#9AA8C2;--line:#25324D;--accent:#3FD0B5;--accent-ink:#06231E;--warn:#F0B35A;--hbg:rgba(12,20,36,.92);color-scheme:dark}
html{scroll-padding-top:calc(72px + env(safe-area-inset-top,0px));scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--body)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--hbg);z-index:10}
a{color:inherit}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--disp);line-height:1.1;margin:0;letter-spacing:-.02em}
h2{font-size:clamp(1.7rem,3.4vw,2.3rem);margin-bottom:10px}
section{padding:68px 0 8px}
.lede{color:var(--muted);max-width:60ch;margin:0 0 28px}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:6px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:11;background:var(--hbg);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:16px;height:64px}
.logo{font:700 1.15rem var(--disp);text-decoration:none;margin-right:auto}
nav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0}
nav a{display:block;padding:8px 12px;border-radius:8px;text-decoration:none;color:var(--muted);font-weight:500}
nav a:hover{color:var(--ink);background:var(--line)}
.icon{width:42px;height:42px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;font-size:1.1rem}
#menu{display:none}
.btn{display:inline-block;padding:13px 22px;border-radius:10px;font-weight:600;text-decoration:none;border:1px solid var(--accent);cursor:pointer;font:600 1rem var(--body)}
.btn.main{background:var(--accent);color:var(--accent-ink)}
.btn.main:hover{filter:brightness(1.08)}
.btn.alt{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.alt:hover{border-color:var(--accent)}
.hero{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center;padding:64px 0 24px}
.hero h1{font-size:clamp(2.4rem,5.6vw,3.9rem);margin-bottom:18px}
.hero p{color:var(--muted);max-width:46ch;margin:0 0 26px;font-size:1.08rem}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.board{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px 22px 18px}
.stages,.lane-track{display:grid;grid-template-columns:repeat(4,1fr)}
.stages{font-size:.82rem;color:var(--muted);font-weight:500;margin-bottom:6px}
.lane{margin:14px 0}
.lane-name{font-weight:600;font-size:.93rem;margin-bottom:6px}
.lane-track{position:relative;height:38px;background:var(--bg);border-radius:10px;border:1px solid var(--line)}
.lane-track i{border-right:1px dashed var(--line)}
.lane-track i:last-child{border:0}
.deal{position:absolute;top:4px;left:4px;height:28px;width:calc(25% - 8px);border-radius:8px;background:var(--ink);color:var(--bg);font-size:.76rem;font-weight:600;display:flex;align-items:center;justify-content:center;transition:left .9s cubic-bezier(.6,0,.2,1),background .4s;white-space:nowrap;overflow:hidden}
.deal.risk{background:var(--warn);color:#201300}
.deal.won{background:var(--accent);color:var(--accent-ink)}
.board small{display:block;color:var(--muted);margin-top:10px;font-size:.8rem}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);border-radius:14px;background:var(--surface);margin-top:40px}
.stat{padding:22px;border-right:1px solid var(--line)}
.stat:last-child{border:0}
.stat b{display:block;font:700 2.2rem/1 var(--disp);color:var(--accent);margin-bottom:6px}
.stat span{color:var(--muted);font-size:.9rem;display:block}
.acc{border:1px solid var(--line);border-radius:14px;background:var(--surface);margin-bottom:12px;overflow:hidden}
.acc>button{all:unset;box-sizing:border-box;width:100%;display:flex;align-items:center;gap:14px;padding:20px 22px;cursor:pointer}
.acc>button:focus-visible{outline:3px solid var(--accent);outline-offset:-3px}
.acc h3{font-size:1.2rem;flex:1}
.acc .meta{color:var(--muted);font-size:.9rem;font-weight:500}
.chev{width:12px;height:12px;border-right:2.5px solid var(--accent);border-bottom:2.5px solid var(--accent);transform:rotate(45deg);transition:transform .3s;flex:none;margin:-4px 4px 0}
.acc.open .chev{transform:rotate(-135deg);margin-top:4px}
.panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s ease}
.acc.open .panel{grid-template-rows:1fr}
.panel>div{overflow:hidden}
.inner{padding:0 22px 22px;border-top:1px solid var(--line);padding-top:18px}
.inner dl{margin:0;display:grid;grid-template-columns:130px 1fr;gap:10px 18px}
.inner dt{font-weight:600}
.inner dd{margin:0;color:var(--muted)}
.inner dd.res{color:var(--ink);font-weight:600}
.inner ul{margin:0;padding-left:20px;color:var(--muted)}
.inner li{margin-bottom:6px}
.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px}
.card h3{font-size:1.25rem;margin-bottom:10px;color:var(--accent)}
.card ul{margin:0;padding-left:18px;color:var(--muted)}
.contact{background:var(--ink);color:var(--bg);border-radius:20px;padding:44px 36px;margin:68px 0 40px}
.contact h2{color:var(--bg)}
.contact p{max-width:52ch;opacity:.85;margin:0 0 24px}
.contact .btn.alt{color:var(--bg);border-color:rgba(255,255,255,.35)}
.contact .btn.main{background:var(--accent);color:var(--accent-ink)}
#msg{margin-left:6px;font-size:.9rem}
footer{color:var(--muted);font-size:.9rem;padding:8px 0 36px}
@media (max-width:820px){
 .hero{grid-template-columns:1fr;gap:32px;padding-top:40px}
 .stats{grid-template-columns:1fr 1fr}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}
 .cols{grid-template-columns:1fr}
 .inner dl{grid-template-columns:1fr;gap:2px}.inner dd{margin-bottom:10px}
 #menu{display:block}
 nav{position:absolute;top:64px;left:0;right:0;background:var(--bg);border-bottom:1px solid var(--line);display:none;padding:8px 16px 14px}
 nav.open{display:block}nav ul{flex-direction:column}
 .acc .meta{display:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
